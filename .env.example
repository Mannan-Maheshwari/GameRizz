# Server configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database configuration (MongoDB / MongoDB Atlas Free M0)
MONGODB_URI=mongodb://localhost:27017/gamerizz

# Session & Security secrets (Must be randomized, unguessable strings in production)
SESSION_SECRET=replace_with_a_random_cryptographic_secret_min_32_chars
ADMIN_JWT_SECRET=replace_with_a_random_jwt_signing_secret_min_32_chars

# Administrator initial credentials (for seeding / initial setup only in secure dev environments)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_temporary_admin_password_in_dev

# Rate limits and game rules timeouts
RATE_LIMIT_WINDOW_MS=5000
RATE_LIMIT_MAX_CHAT=5
RPS_MOVE_TIMEOUT_SECONDS=20
CRICKET_DELIVERY_TIMEOUT_SECONDS=20
RECONNECT_GRACE_PERIOD_SECONDS=30
TICKET_RETENTION_DAYS=90
